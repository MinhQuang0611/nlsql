# Application Configuration
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8388
LOG_LEVEL=INFO

# Active Database (postgres or clickhouse)
ACTIVE_DB=postgres

# PostgreSQL Configuration (External Data)
PG_DB_HOST=localhost
PG_DB_PORT=5432
PG_DB_NAME=qldt
PG_DB_USER=postgres
PG_DB_PASSWORD=

# ClickHouse Configuration (External Data)
CH_DB_HOST=localhost
CH_DB_PORT=8123
CH_DB_NAME=qldt
CH_DB_USER=default
CH_DB_PASSWORD=

# Internal Backend Database (PostgreSQL)
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Database Pool Configuration
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=false

# LLM - OpenAI
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1

# Per-agent model (có thể dùng model mạnh hơn cho sql_gen)
OPENAI_MODEL=gpt-4o-mini
SQL_GEN_MODEL=gpt-4o-mini
RECOMMEND_MODEL=gpt-4o-mini

# LLM parameters
LLM_TEMPERATURE=0.0
RECOMMEND_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=60

# Embedding
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Vector Database (Qdrant)
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# Cache (Redis)
REDIS_HOST=redis
REDIS_PORT=6097
REDIS_URL=redis://redis:6097

# LangChain Tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=nlsql

# Google Sheets
GOOGLE_SHEET_URL=
GOOGLE_SHEETS_CREDENTIALS_FILE=
SHEETS_KNOWLEDGE_ID=
SHEETS_KNOWLEDGE_NAME=
